{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillspace.dev/schemas/v1alpha1/evidence.schema.json",
  "title": "SkillRoster Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "skillspace.dev/v1alpha1" },
    "kind": { "const": "Evidence" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "version", "member", "project", "sessionId", "status", "changedFiles", "coUsedSkills", "createdAt", "privacy"],
      "properties": {
        "skill": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "member": { "$ref": "#/$defs/slug" },
        "project": { "$ref": "#/$defs/slug" },
        "sessionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["used", "verified", "failed", "co-used"] },
        "changedFiles": { "type": "integer", "minimum": 0 },
        "verificationCommand": { "type": "string", "minLength": 1 },
        "verificationPassed": { "type": "boolean" },
        "acceptedCommit": { "type": "string", "minLength": 7 },
        "coUsedSkills": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promptStored", "sourceStored"],
          "properties": {
            "promptStored": { "const": false },
            "sourceStored": { "const": false }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    }
  }
}
