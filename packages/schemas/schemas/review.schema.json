{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillspace.dev/schemas/v1alpha1/review.schema.json",
  "title": "SkillRoster Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "skillspace.dev/v1alpha1" },
    "kind": { "const": "Review" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "version", "reviewer", "score", "comment", "createdAt"],
      "properties": {
        "skill": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "reviewer": { "$ref": "#/$defs/slug" },
        "project": { "$ref": "#/$defs/slug" },
        "score": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    }
  }
}
