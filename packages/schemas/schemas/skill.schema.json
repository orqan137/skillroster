{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillspace.dev/schemas/v1alpha1/skill.schema.json",
  "title": "SkillRoster Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "skillspace.dev/v1alpha1" },
    "kind": { "const": "Skill" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "version", "description", "visibility", "tags", "compatibility", "publishedAt"],
      "properties": {
        "owner": { "$ref": "#/$defs/slug" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["private", "team", "verified", "deprecated"] },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "compatibility": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/slug" } }
    }
  }
}
