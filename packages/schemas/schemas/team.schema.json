{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillspace.dev/schemas/v1alpha1/team.schema.json",
  "title": "SkillRoster Team",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "skillspace.dev/v1alpha1" },
    "kind": { "const": "Team" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "defaultBranch", "owners", "createdAt"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/slug" } }
    }
  }
}
