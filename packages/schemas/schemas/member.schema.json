{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillspace.dev/schemas/v1alpha1/member.schema.json",
  "title": "SkillRoster Member",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "skillspace.dev/v1alpha1" },
    "kind": { "const": "Member" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "email", "role", "joinedAt"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "role": { "enum": ["owner", "maintainer", "member"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/slug" } }
    }
  }
}
