{
  "name": "skill-roster",
  "version": "0.1.0",
  "private": true,
  "description": "Git-native team registry, peer review, and project loadouts for AI agent skills",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "skillroster": "pnpm --filter @skillspace/cli dev",
    "skillspace": "pnpm --filter @skillspace/cli dev",
    "dev": "pnpm --filter @skillspace/web dev",
    "start": "pnpm --filter @skillspace/web start",
    "test": "pnpm -r --if-present test",
    "test:run": "pnpm -r --if-present test:run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=22"
  }
}
