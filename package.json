{
  "name": "skill-roster",
  "version": "0.1.0",
  "private": true,
  "description": "Git-native team registry, peer review, and project loadouts for AI agent skills",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "skillroster": "pnpm --filter @skillspace/cli dev",
    "skillspace": "pnpm --filter @skillspace/cli dev",
    "demo": "pnpm --filter @skillspace/cli dev demo",
    "dev": "pnpm --filter @skillspace/web dev",
    "start": "pnpm --filter @skillspace/web start",
    "test": "pnpm -r --if-present test",
    "test:policy": "node --test scripts/*.test.mjs",
    "test:run": "pnpm test:policy && pnpm -r --if-present test:run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint .",
    "license:check": "node scripts/check-licenses.mjs",
    "verify": "pnpm lint && pnpm license:check && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10"
  }
}
