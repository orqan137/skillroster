{
  "name": "@skillspace/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "skillroster": "dist/index.cjs",
    "skillspace": "dist/index.cjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node dist/index.cjs --cli-version",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@skillspace/core": "workspace:*",
    "@skillspace/git": "workspace:*",
    "@skillspace/opencode-plugin": "workspace:*",
    "@skillspace/schemas": "workspace:*",
    "commander": "^14.0.2",
    "simple-git": "^3.28.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
