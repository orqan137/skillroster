  <diagram id="skillroster-features" name="프로젝트 주요 기능">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" value="프로젝트 주요 기능" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Pretendard;fontSize=32;fontStyle=1;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="500" height="50" as="geometry"/></mxCell>
      <mxCell id="n1" value="&lt;b&gt;01&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;로스터 생성과 참여&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;새 로스터 만들기&lt;br&gt;기존 로스터 참여&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;원격 Git 저장소 연결&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="330" height="250" as="geometry"/></mxCell>
      <mxCell id="n2" value="&lt;b&gt;02&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;스킬 공유&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;SKILL.md · 설명 · 태그&lt;br&gt;참고 위치 · 공유 파일&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;선택한 내용만 Git에 등록&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="330" height="250" as="geometry"/></mxCell>
      <mxCell id="n3" value="&lt;b&gt;03&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;스킬 평가와 후기&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;작성자 평가 · 동료 평가&lt;br&gt;프로젝트 사용 이력&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;팀 안에서 순위 확인&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="330" height="250" as="geometry"/></mxCell>
      <mxCell id="n4" value="&lt;b&gt;04&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;프로젝트 생성과 스킬 선택&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;기술 태그 · 평가 순위&lt;br&gt;스킬 추가·제외&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;팀원 누구나 생성&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="1190" y="150" width="330" height="250" as="geometry"/></mxCell>
      <mxCell id="n5" value="&lt;b&gt;05&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;팀 Git과 프로젝트 Git 저장소 연동&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;팀 로스터 · 프로젝트 저장소&lt;br&gt;.skillroster/project.yaml&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;프로젝트에 스킬 구성 저장&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="454" height="250" as="geometry"/></mxCell>
      <mxCell id="n6" value="&lt;b&gt;06&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;도구별 스킬 설치&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;OpenCode · Codex · Claude Code&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;.opencode · .agents · .claude&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="573" y="440" width="454" height="250" as="geometry"/></mxCell>
      <mxCell id="n7" value="&lt;b&gt;07&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;팀원과 로스터 관리&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;팀원과 역할 확인&lt;br&gt;사용자 · Git · 저장 경로 설정&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#59635D&quot;&gt;여러 로스터 전환&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D1510;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Pretendard;fontSize=14;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="1066" y="440" width="454" height="250" as="geometry"/></mxCell>
      <mxCell id="band" value="&lt;b&gt;Git 기반 관리&lt;/b&gt;　스킬 · 평가 · 프로젝트 구성을 Git에 저장해 변경 이력 확인" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FFF8;strokeColor=#00B85C;strokeWidth=2;align=left;spacingLeft=28;verticalAlign=middle;fontFamily=Pretendard;fontSize=15;fontColor=#0D1510;" vertex="1" parent="1"><mxGeometry x="80" y="735" width="1440" height="90" as="geometry"/></mxCell>
